# Dependencies / build output (Expo scaffold will extend this)
node_modules/
.expo/

# Personal/local Claude Code settings — never commit (per-machine allows)
.claude/settings.local.json

# Local Codex sandbox permissions — each machine owns its own policy.
/.codex/config.toml

# Graphify: graph.json + GRAPH_REPORT.md (in .planning/graphs/) are committed;
# these are regenerated wholesale every build and would bloat history (CLAUDE.md).
.planning/graphs/graph.html
.planning/graphs/.last-build-snapshot.json

# graphify-out/ is the pristine per-build output; .planning/graphs/ holds the
# committed, normalized copy. Never commit the raw build dir.
graphify-out/

# Expo / native build output (generated by prebuild — never committed)
/android
/ios
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo

# Android signing material — never commit
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Android build artifacts pulled from the desktop build pipeline
app-release.apk
app-debug.apk
*.apk

# GSD session locks — transient, per-process (never commit)
.planning/*.lock

# GSD runtime dispatch sentinel — transient per-process state, not source
.gsd/

# UAT screenshots — on-device evidence, synced to the Obsidian vault via
# Syncthing (which ignores .gitignore); kept out of git to avoid binary
# history bloat. No screenshots have ever been committed here.
**/uat-shots/

# Dossier-audit prior test runs only; the current LEDGER.md / AUDIT-REPORT.md are tracked.
docs/dossier/milestone-2/audit/prior-runs/
