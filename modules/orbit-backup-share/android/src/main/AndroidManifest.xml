<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Receives the chooser's EXTRA_CHOSEN_COMPONENT so read access is granted
         to the one app the user picked (ADR-155). Not exported: only this app's
         own PendingIntent can target it. -->
    <receiver
      android:name=".ChosenShareTargetReceiver"
      android:exported="false" />
  </application>
</manifest>
