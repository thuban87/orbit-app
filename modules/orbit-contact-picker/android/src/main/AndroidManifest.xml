<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    READ_CONTACTS applies on ALL supported API levels, INCLUDING API 37+.
    ADR-003 (supersedes ADR-002's API-37 "no READ_CONTACTS" clause / the former
    maxSdkVersion="36" cap) for the Phase-20 reconcile RE-READ: reconcile reads the
    live state of an already-linked set via ContactsContract, which the permissionless
    system picker cannot serve. IMPORT still uses the permissionless picker (≥37) /
    in-app picker (≤36). Requested in-context via ensureReadContactsPermission before a
    reconcile read. Play: file the Contacts declaration (CRM / Contact Management) at
    release — see ADR-003.
  -->
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <!--
    Package-visibility (Android 11+) declaration for the system contact picker.
    Without this, targetSdk 36 filtering hides `com.android.contactspicker` from
    the app, so `startActivityForResult` for the pick intent falls through to the
    system resolver ("No apps can perform this action") — even though the picker
    exists and `am start` from shell launches it. Scoped to the contact-pick
    intent(s) only: NO READ_CONTACTS, NO QUERY_ALL_PACKAGES (the picker is
    permissionless by design). See gap plan 19-19.
  -->
  <queries>
    <intent>
      <action android:name="android.provider.action.PICK_CONTACTS" />
    </intent>
    <intent>
      <action android:name="android.intent.action.PICK" />
      <data android:mimeType="vnd.android.cursor.dir/contact" />
    </intent>
  </queries>
</manifest>
